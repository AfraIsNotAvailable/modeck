[Unit]
Description=Desktop PC Control app
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/afra/dev/web/modeck/server
ExecStart=/home/afra/dev/web/modeck/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8765 --ssl-keyfile ./key.pem --ssl-certfile ./cert.pem
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
